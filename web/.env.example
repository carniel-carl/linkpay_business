# Base URL of the LinkPay backend (server-side only, never exposed to the browser).
API_URL=http://localhost:4000
# Shown on the rejected-business screen and in help text.
NEXT_PUBLIC_SUPPORT_EMAIL=support@linkpay.ng
# The header the platform in front of this server sets with the visitor's IP (never one the browser sends):
# x-real-ip or x-forwarded-for on Vercel, cf-connecting-ip behind Cloudflare. Unset, rate limits can't tell visitors apart.
# CLIENT_IP_HEADER=x-real-ip
# Set to 1 to send the page Content-Security-Policy as report-only while rolling it out (enforcing by default).
# CSP_REPORT_ONLY=1
