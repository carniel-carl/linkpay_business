# Copy to backend/.env for local development (Bun loads it automatically). Never commit real values.
# Production settings and rules: docs/DEPLOY.md. For a local API with no real services, use `bun run dev:mock`
# instead (it ignores this file).

# development | test | production. Set it explicitly: production must say "production".
NODE_ENV=development
PORT=4000
APP_NAME=LinkPay

# MongoDB. Username and password go separately, so the password never needs URL-encoding.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=linkpay_business
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Secrets: at least 32 random characters each, all different. Generate with: openssl rand -hex 32
JWT_SECRET=
STAFF_JWT_SECRET=
# 64 hex characters (32 bytes). Encrypts BVNs. Changing it makes stored BVNs unreadable.
ENCRYPTION_KEY=
# Set to 1 once `bun run migrate:encryption --apply` reports nothing left in the old format.
ENCRYPTION_REQUIRE_V2=

# Liquifia. Use an sk_test_ key in development; an sk_live_ key outside production is refused
# unless LIQUIFIA_ALLOW_LIVE=1 (never set that in production).
LIQUIFIA_SECRET_KEY=sk_test_
LIQUIFIA_BASE_URL=https://fiat-api.pouchfinance.xyz/api/v1
LIQUIFIA_WEBHOOK_SECRET=
LIQUIFIA_ALLOW_LIVE=
# Milliseconds between payment syncs and payout follow-ups. Plain digits (60000, not 60_000). 0 turns both off.
LIQUIFIA_SYNC_INTERVAL_MS=60000

# Token and session lifetimes.
JWT_EXPIRES_IN=7d
ACCESS_TOKEN_TTL=15m
SESSION_IDLE_DAYS=30
SESSION_MAX_AGE_DAYS=90
BIOMETRIC_IDLE_DAYS=60
BIOMETRIC_MAX_AGE_DAYS=180

# Public URLs: this API (shown in payment-link embed code), the web app and the admin console.
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Proxies whose X-Forwarded-For is believed: the web and admin servers' addresses as this API sees them,
# plus any load balancer in front of it. Comma-separated; never `true`, a hop count or a /0 range.
TRUST_PROXY=loopback

# Verification documents and uploads (local folder, gitignored).
UPLOAD_DIR=uploads

# Phone pushes: "expo" sends them; anything else prints them to the console (use expo in production).
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

# The oldest mobile app version the API works with, e.g. 1.4.0. Older phones, and builds that don't send their
# version, get APP_UPDATE_REQUIRED and the app's update screen. Empty: any version.
MIN_MOBILE_APP_VERSION=
