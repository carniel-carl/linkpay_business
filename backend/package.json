  "private": true,
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pdfkit": "^0.17.6",
    "mongodb-memory-server": "^11.3.0"
  },
  "peerDependencies": {
