# Copy to .env.local. Only EXPO_PUBLIC_* values reach the app, and they are bundled in plain text:
# never put secrets here.

# API base URL. In development it defaults to the Metro host on port 4000. Release builds require https.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=support@linkpay.ng
# Development only: set to 1 to allow screenshots and screen recording (they're blocked otherwise).
EXPO_PUBLIC_ALLOW_SCREEN_CAPTURE=
